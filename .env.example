# ============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit secrets.
#
# Generate strong random secrets with:
#   openssl rand -base64 32
# Run once per secret, or use `openssl rand -base64 32 | tr -d '\n' && echo`
# ============================================================================

# ---- Postgres ----
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32

# ---- Strapi secrets (generate each with `openssl rand -base64 32`) ----
# APP_KEYS is a comma-separated list of 4 keys used to rotate session secrets.
APP_KEYS=CHANGE_ME_1,CHANGE_ME_2,CHANGE_ME_3,CHANGE_ME_4
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# ---- Production only (used by docker-compose.prod.yml) ----
# Public domain that Caddy will serve + obtain a Let's Encrypt cert for.
# For local testing, use `localhost` — Caddy will issue an internal self-signed cert.
DOMAIN=localhost

# Email for Let's Encrypt expiration notices. REQUIRED for non-localhost domains.
# DO NOT ship the placeholder — Let's Encrypt will rate-limit + refuse issuance.
ACME_EMAIL=

# ---- Strapi runtime tuning ----
# Comma-separated list of allowed CORS origins for the Strapi API.
# In prod this is forced to https://${DOMAIN} by docker-compose.prod.yml.
CORS_ORIGIN=http://localhost:5173
